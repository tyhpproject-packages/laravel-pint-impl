{
    "name": "tyhpdef/laravel-pint-impl",
    "description": "Implementation package for tyhpdef/laravel-pint. Require tyhpdef/laravel-pint, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.32.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/friendsofphp-php-cs-fixer": "@dev",
                "tyhpdef/illuminate-view": "@dev",
                "tyhpdef/laravel-prompts": "@dev",
                "tyhpdef/nunomaduro-termwind": "@dev",
                "tyhpdef/composer-semver": "@dev",
                "tyhpdef/symfony-process": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/laravel-pint"
        }
    },
    "require": {
        "php": ">=8.2",
        "laravel/pint": "1.32.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/friendsofphp-php-cs-fixer": "@dev",
        "tyhpdef/illuminate-view": "@dev",
        "tyhpdef/laravel-prompts": "@dev",
        "tyhpdef/nunomaduro-termwind": "@dev",
        "tyhpdef/composer-semver": "@dev",
        "tyhpdef/symfony-process": "@dev"
    }
}
